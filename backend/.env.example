# ================= 服务端口 =================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ================= LLM 配置 =================
#
# 说明：
#  写法 A（和其他项目一致）：直接写标准 OPENAI_* 变量名
#    OPENAI_API_KEY=xxx
#    OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#    MODEL_NAME=glm-4.5-flash
#
#  写法 B（项目自有命名，优先级更高）：
#    LLM_API_KEY=xxx
#    LLM_BASE_URL=xxx
#    LLM_CHAT_MODEL=glm-4.5-flash
#
#  注意：URL 上不要加反引号！直接 https://... 即可
#        config.py 已内置自动清污逻辑，反引号会被去除，但建议你就不要写了。
#
# 方案一：智谱 GLM（国内稳定，推荐，OpenAI 兼容协议）
LLM_PROVIDER=zhipu
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4.5-flash

# 方案二：通义千问 DashScope
# LLM_PROVIDER=dashscope
# OPENAI_API_KEY=your_dashscope_api_key_here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus

# 方案三：SiliconFlow 硅基流动
# LLM_PROVIDER=siliconflow
# OPENAI_API_KEY=your_siliconflow_key
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 方案四：Ollama 本地模型
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_CHAT_MODEL=qwen2.5:7b

# ================= 嵌入模型配置 =================
#
#  方案一：SiliconFlow BGE-M3（性价比高，用户当前方案）
EMBED_PROVIDER=siliconflow
EMBED_API_KEY=your_siliconflow_key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIMENSION=1024

# 方案二：智谱 embedding-3
# EMBED_PROVIDER=zhipu
# EMBED_API_KEY=your_zhipu_api_key_here
# EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBED_MODEL=embedding-3
# EMBED_DIMENSION=256

# 方案三：本地 HuggingFace BGE-M3（纯离线，需下载模型）
# EMBED_PROVIDER=local
# EMBED_MODEL=BAAI/bge-m3
# EMBED_DIMENSION=1024

# 方案四：Ollama 本地嵌入
# EMBED_PROVIDER=ollama
# EMBED_BASE_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text
# EMBED_DIMENSION=768

# ================= 向量数据库配置 =================
VECTOR_DB_TYPE=chroma                            # chroma / qdrant / faiss
VECTOR_DB_PATH=./vector_db                       # ChromaDB 本地持久化目录
VECTOR_DB_COLLECTION=my_rag_knowledge            # 集合名（类似表名）

# ================= RAG 超参数 =================
RAG_CHUNK_SIZE=500                               # 每块字符数
RAG_CHUNK_OVERLAP=80                             # 相邻块重叠字符数
RAG_TOP_K=6                                      # 检索召回 Top-K
RAG_SIMILARITY_THRESHOLD=0.6                     # 相似度阈值（低于过滤）
RAG_ENABLE_RERANK=true                           # 是否启用重排序（开关）
RAG_RERANK_TOP_N=3                               # 重排后保留 N 条（N<K）
RAG_MAX_TOKENS_LIMIT=8000                        # 上下文最大 Token
RAG_SUMMARY_THRESHOLD=4000                      # 触发摘要的 Token 阈值

# ================= 查询重构（Query Rewriting）=================
#
# 说明：检索前的两步查询优化（参考"四大查询重构技术"）：
#   1. Multi-Query 多查询分解：LLM 把问题拆成 主查询(关键词+同义词) + N-1 个子查询，
#      每路各做 dense + BM25 检索，全部 RRF 融合（默认开启）
#   2. HyDE 假设文档：LLM "编"一段假设答案，用它的语义去搜真文档，
#      弥合疑问句与陈述句文档的语义鸿沟（默认关闭，多一次 LLM 调用）
#
MULTI_QUERY_ENABLE=true                          # 多查询分解开关
MULTI_QUERY_COUNT=3                              # 总查询数（1 主 + 2 子）
HYDE_ENABLE=false                                # HyDE 假设文档开关
HYDE_DOC_LEN=200                                 # 假设文档目标字数

# ================= Rerank 重排序配置 =================
#
# 说明：启用 RAG_ENABLE_RERANK=true 后，会在向量检索后多一步"语义重排"，
#       把与 query 最相关的 chunk 顶到前面，减少噪声块进入上下文。
#       所有失败/超时/无配置情况都会自动降级为"按向量分数截断"，不阻塞流程。
#
#  方案 A：SiliconFlow 远端 API（推荐，和 BGE-M3 embedding 复用 key）
#    模型默认 BAAI/bge-reranker-v2-m3，$0.02 / 百万 tokens，很快 ~100ms
RERANK_ENABLE=true
RERANK_PROVIDER=remote                           # remote | local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 没写时复用 EMBEDDING_BASE_URL（SiliconFlow: https://api.siliconflow.cn/v1）
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# 没写时复用 EMBEDDING_API_KEY
# RERANK_API_KEY=your_siliconflow_key
RERANK_TIMEOUT=10.0                              # 秒，超时直接降级
RERANK_TOP_N=3                                   # 重排后保留条数（覆盖 RAG_RERANK_TOP_N）

# 方案 B：本地 CrossEncoder（免费，复用 RAG-Pro 已有 bge-reranker-v2-m3 模型）
#    如果 D:\ai学习项目\RAG-Pro\backend\models\BAAI\bge-reranker-v2-m3 存在，
#    自动加载本地模型（FlagReranker / FlagEmbedding），CPU ~300ms
# RERANK_ENABLE=true
# RERANK_PROVIDER=local
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TOP_N=3
# RERANK_DEVICE=cpu                               # cpu | cuda

# ================= 路径配置 =================
UPLOAD_DIR=./data/uploads

# ================= LangSmith（可选，调试 LangChain 调用链）=================
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=my-rag

# ================= 可选：Tavily 联网搜索 =================
# TAVILY_API_KEY=your_tavily_key

